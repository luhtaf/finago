# Wajib: secret JWT. Generate: openssl rand -hex 32
# ⚠️ Kalau beda dengan JWT_SECRET di Cloudflare → semua user harus login ulang (wajar saat pindah).
JWT_SECRET=

# Kosongkan dulu (akses via http://IP-VPS). Isi pas domain sudah diarahkan ke IP VPS,
# mis. FINAGO_DOMAIN=fina.kartabhumi.co.id → Caddy otomatis pasang HTTPS.
FINAGO_DOMAIN=
