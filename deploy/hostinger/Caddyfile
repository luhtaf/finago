{$FINAGO_DOMAIN} {
	encode gzip zstd
	# upload nota maks 10 MB di app → kasih ruang sedikit
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy finago:8787
}
