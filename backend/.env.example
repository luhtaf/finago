# libSQL/Turso. Kosongin DATABASE_URL → default file:./local.db (dev lokal).
DATABASE_URL=
DATABASE_AUTH_TOKEN=
PORT=8787

# Microsoft Graph (OneDrive) — lihat SETUP-ONEDRIVE.md buat cara dapetinnya
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=
GRAPH_WORKBOOK_ITEM_ID=
GRAPH_WORKBOOK_TABLE=Table1
GRAPH_FOLDER_PATH=FINA-go/pengajuan
# Nyalain cron sync ke OneDrive (default mati). Set 'on' setelah GRAPH_* terisi.
SYNC_CRON=off

# Object storage (S3-compatible). Kosong → fallback FS lokal (.r2-store/).
# MinIO lokal (sementara):
#   docker run -d -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin minio/minio server /data --console-address ":9001"
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=finago
# R2_REGION=us-east-1
# Pindah ke Cloudflare R2: ganti R2_ENDPOINT ke https://<acct>.r2.cloudflarestorage.com + key R2, kode sama.
