# ── FINA go backend — contoh env. Copy ke .env, isi sesuai kebutuhan. ──
# .env GAK ke-commit (di .gitignore) & GAK ke-upload ke Workers (pakai `wrangler secret put`).

# ── Database (libSQL/Turso) ──
# Kosongin DATABASE_URL → default file:./local.db (dev lokal).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ── Auth ──
# WAJIB di prod. Generate: openssl rand -hex 32
JWT_SECRET=

# ── Server (Node entry; di Workers di-handle runtime) ──
PORT=8787

# ── Object storage (S3-compatible) ──
# Kosong → fallback FS lokal (.r2-store/). Di Workers pakai R2 binding (gak perlu key ini).
# MinIO lokal (sementara):
#   docker run -d -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin minio/minio server /data --console-address ":9001"
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=finago
# R2_REGION=us-east-1
# Pindah ke Cloudflare R2: ganti R2_ENDPOINT ke https://<acct>.r2.cloudflarestorage.com + key R2.

# ── Sync mirror (opsional) — pilih SALAH SATU provider ──
# none (default) = sync mati. google = gratis (service account). microsoft = butuh akun KERJA berbayar.
SYNC_PROVIDER=none
# Cron sync (Node only; di Workers pakai Cron Trigger di wrangler.toml). 'on' buat nyalain.
SYNC_CRON=off

# --- kalau SYNC_PROVIDER=google (Drive + Sheets, service account) ---
# Bikin service account di Google Cloud → download JSON key → share folder Drive + Sheet ke email SA (Editor).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private_key dari JSON (boleh satu baris dengan \n ter-escape).
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1

# --- kalau SYNC_PROVIDER=microsoft (OneDrive for Business / SharePoint via Graph) ---
# Butuh akun KERJA (M365 Business) — akun personal (M365 Family) GAK BISA. Lihat SETUP-ONEDRIVE.md.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=
GRAPH_WORKBOOK_ITEM_ID=
GRAPH_WORKBOOK_TABLE=Table1
GRAPH_FOLDER_PATH=FINA-go/pengajuan
